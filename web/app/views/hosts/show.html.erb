<% content_for :title, "Your game" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") if @host_token %>

<div class="stack">
  <h1>Your game</h1>
  <%= render "phases/header", phase: @phase %>
  <% @dislodged.each do |dislodged| %>
    <%= render "shared/banner", kind: "warning",
          text: "#{power_name(dislodged.unit.power)}'s #{dislodged.unit.type} in #{dislodged.unit.location.province.to_s.upcase} was dislodged. Settle it by hand." %>
  <% end %>

  <% if @host_token %>
    <div class="field">
      <label class="field__label" for="host-link">Your host link</label>
      <input class="control" id="host-link" type="text" readonly aria-describedby="host-link-hint" value="<%= game_host_link_url(@game.public_id, token: @host_token) %>">
      <span class="field__hint" id="host-link-hint">Keep it private. Anyone who has it controls this game.</span>
    </div>
  <% end %>

  <section class="host-section stack" aria-labelledby="host-heading">
    <h2 id="host-heading">Host</h2>
    <%= link_to "Reveal orders", game_reveal_path(@game.public_id, @phase.number), class: "button" %>
    <% if @game.open? %>
      <% join_link = join_game_url(@game.join_code) %>
      <%= qr_card(join_link, label: "QR code to join the game", caption: join_code_text(@game.join_code)) %>
      <p>Joining is open. Players scan the code or type the join code at <strong><%= join_url %></strong>.</p>
      <%= link_to "Close joining", game_close_path(@game.public_id), class: "button button--secondary" %>
    <% else %>
      <p>Joining is closed.</p>
    <% end %>

    <h3>Seats</h3>
    <ul class="list">
      <% RulesEngine.powers.each do |power| %>
        <% id = power.id.to_s %>
        <li>
          <% if @seats[id] %>
            <%= link_to safe_join([ power_badge(id), tag.span("Reissue seat") ]), game_reissue_path(@game.public_id, id), class: "list__row" %>
          <% else %>
            <div class="list__row"><%= power_badge(id) %> <span>Open</span></div>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "step_ins/entry", game: @game, seats: @seats, phase: @phase %>
  </section>

  <section class="stack" aria-labelledby="history-heading" data-history>
    <h2 id="history-heading">Revealed phases</h2>
    <% if @history.empty? %>
      <p>No phase has been revealed yet.</p>
    <% else %>
      <ul class="list">
        <% @history.each do |past| %>
          <li><div class="list__row"><span class="mono"><%= past.title %></span> <span class="text-muted">revealed</span></div></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%= link_to "Your own seat", game_path(@game.public_id), class: "button button--secondary" %>
</div>
