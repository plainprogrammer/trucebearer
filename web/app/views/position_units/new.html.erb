<% content_for :title, "Add a unit" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>

<div class="stack">
  <h1>Add a unit</h1>
  <%= render "phases/header", phase: @phase %>
  <%= render "positions/refusal" %>
  <%= form_with url: game_position_units_path(@game.public_id, @phase.number), method: :post, class: "stack" do %>
    <div class="field">
      <label class="field__label" for="unit-power">Power</label>
      <%= select_tag "unit[power]", options_for_select([ [ "Choose a power", "" ] ] + power_options, field(:unit, :power)), id: "unit-power", class: "control" %>
    </div>
    <%= render "shared/segmented", legend: "Unit", name: "unit[type]", options: [ %w[army Army], %w[fleet Fleet] ], selected: field(:unit, :type) || "army" %>
    <div class="field">
      <label class="field__label" for="unit-province">Province</label>
      <%= select_tag "unit[province]", options_for_select([ [ "Choose a province", "" ] ] + province_options, field(:unit, :province)), id: "unit-province", class: "control" %>
    </div>
    <div class="field">
      <label class="field__label" for="unit-coast">Coast</label>
      <%= select_tag "unit[coast]", options_for_select(coast_options, field(:unit, :coast)), id: "unit-coast", class: "control", "aria-describedby": "unit-coast-hint" %>
      <span class="field__hint" id="unit-coast-hint">If a fleet needs a coast, the page will say so.</span>
    </div>
    <%= render "positions/clears_note", clears: true %>
    <%= button_tag "Add unit", type: "submit", class: "button" %>
  <% end %>
</div>

<% content_for :actions do %>
  <%= link_to "Back", editor_path, class: "button button--secondary" %>
<% end %>
