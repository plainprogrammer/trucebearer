<% name = RulesEngine.province_name(@province) %>
<% content_for :title, "#{@unit.type.to_s.capitalize} in #{name}" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>

<div class="stack">
  <h1><%= power_name(@unit.power) %>'s <%= @unit.type %> in <%= name %></h1>
  <%= render "phases/header", phase: @phase, power: @unit.power %>
  <%= render "positions/refusal" %>
  <p><%= unit_icon(@unit.power, @unit.type, size: 32, decorative: true) %> <%= @unit.type.to_s.capitalize %> in <%= province_label(@province) %><%= ", #{OrderLabelHelper::COASTS.fetch(@unit.location.coast.to_s)}" if @unit.location.coast %></p>

  <%= form_with url: game_position_unit_path(@game.public_id, @phase.number, @province), method: :patch, class: "stack" do %>
    <h2>Move it</h2>
    <div class="field">
      <label class="field__label" for="unit-province">Move to</label>
      <%= select_tag "unit[province]", options_for_select([ [ "Choose a province", "" ] ] + province_options, field(:unit, :province)), id: "unit-province", class: "control" %>
    </div>
    <div class="field">
      <label class="field__label" for="unit-coast">Coast</label>
      <%= select_tag "unit[coast]", options_for_select(coast_options, field(:unit, :coast)), id: "unit-coast", class: "control", "aria-describedby": "unit-coast-hint" %>
      <span class="field__hint" id="unit-coast-hint">If a fleet needs a coast, the page will say so.</span>
    </div>
    <%= render "positions/clears_note", clears: true %>
    <%= button_tag "Move unit", type: "submit", class: "button" %>
  <% end %>

  <section class="stack" aria-labelledby="remove-heading">
    <h2 id="remove-heading">Remove it</h2>
    <%= render "positions/clears_note", clears: true %>
    <%= button_to "Remove unit", game_position_unit_path(@game.public_id, @phase.number, @province), method: :delete, class: "button button--danger" %>
  </section>
</div>

<% content_for :actions do %>
  <%= link_to "Back", editor_path, class: "button button--secondary" %>
<% end %>
