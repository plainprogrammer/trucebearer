<% content_for :title, "Phase revealed" %>

<div class="stack">
  <h1><%= @stepped_in_page ? "#{power_name(@seat.power)}'s orders" : "Your orders" %></h1>
  <%= render "phases/header", phase: @phase, power: @seat.power %>
  <%= render "shared/banner", kind: "danger", text: "The host has already revealed this phase. Your orders were not saved." %>
  <%= link_to "Go to the current phase", orders_path_for(@game.current_phase.number), class: "button" %>
</div>
