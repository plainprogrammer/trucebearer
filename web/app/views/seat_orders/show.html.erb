<% content_for :title, "Your orders" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>

<div class="stack">
  <h1>Your orders</h1>
  <%= render "phases/header", phase: @phase, power: @seat.power %>
  <% if @refusal %><%= render "shared/banner", kind: "danger", text: @refusal %><% end %>
  <p><%= @seat.submitted?(@phase) ? "Submitted" : "Not submitted" %>. <%= @stored.size %> of <%= @units.size %> units ordered. A unit with no order holds.</p>

  <%= form_with url: game_seat_orders_path(@game.public_id, @phase.number), method: :put, id: "orders-form", class: "stack" do %>
    <% @units.each do |unit| %>
      <% province = unit.location.province.to_s %>
      <div class="field">
        <label class="field__label" for="order-<%= province %>">
          <%= unit_icon(unit.power, unit.type, size: 32, decorative: true) %>
          <%= unit.type.to_s.capitalize %> in <span class="mono"><%= province.upcase %></span>
        </label>
        <select class="control" id="order-<%= province %>" name="orders[<%= province %>]">
          <option value="">No order (holds)</option>
          <% RulesEngine.legal_orders(@phase.position, unit).each do |order| %>
            <%= tag.option order_label(order), value: JSON.generate(order.to_h), selected: @stored[province] == order %>
          <% end %>
        </select>
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :actions do %>
  <%= button_tag "Save orders", type: "submit", name: nil, form: "orders-form", class: "button button--secondary" %>
  <%= button_tag "Save and submit", type: "submit", name: "submit", value: "1", form: "orders-form", class: "button" %>
<% end %>
