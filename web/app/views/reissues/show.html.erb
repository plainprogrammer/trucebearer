<% content_for :title, "Reissue a seat" %>

<%= render layout: "shared/confirm", locals: { title: "Reissue #{power_name(@seat.power)}", confirm_label: "Reissue seat", danger: true,
      confirm_path: game_reissue_path(@game.public_id, @seat.power), cancel_path: game_host_path(@game.public_id) } do %>
  <p>The phone that holds this seat loses it at once. The seat's saved orders for this phase are deleted with it. Show the new QR code to the player who takes it over.</p>
<% end %>
