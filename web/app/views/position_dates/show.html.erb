<% content_for :title, "Season and year" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>

<div class="stack">
  <h1>Season and year</h1>
  <%= render "phases/header", phase: @phase %>
  <%= render "positions/refusal" %>
  <%= form_with url: game_position_date_path(@game.public_id, @phase.number), method: :put, class: "stack" do %>
    <%= render "shared/segmented", legend: "Season", name: "date[season]", options: [ %w[spring Spring], %w[fall Fall] ], selected: field(:date, :season) || @phase.position.season %>
    <div class="field">
      <label class="field__label" for="date-year">Year</label>
      <%= text_field_tag "date[year]", field(:date, :year) || @phase.position.year, id: "date-year", class: "control", inputmode: "numeric", autocomplete: "off", "aria-describedby": "date-year-hint" %>
      <span class="field__hint" id="date-year-hint">A year from 1901 to 1999.</span>
    </div>
    <%= render "positions/clears_note", clears: false %>
    <%= button_tag "Set season and year", type: "submit", class: "button" %>
  <% end %>
</div>

<% content_for :actions do %>
  <%= link_to "Back", editor_path, class: "button button--secondary" %>
<% end %>
