<%# The one place a banner is written, so a glyph can be added here later (#82). locals: kind ("info", "warning" or "danger"), text.
    Words carry the kind, so colour is never the only signal. %>
<% lead = { "warning" => "Warning: ", "danger" => "Error: " }.fetch(kind.to_s, "") %>
<p class="banner banner--<%= kind %>" role="<%= kind.to_s == "info" ? "status" : "alert" %>"><%= lead %><%= text %></p>
