<%# The host page's one history: each reveal, step-in, reissue and board edit, oldest first (spec 026 D6, D10, D11, spec 027 D4). Phases, powers and times only; a reveal is a link to its results page. locals: game %>
<% entries = game.host_history %>
<section class="stack" aria-labelledby="history-heading" data-seat-history>
  <h2 id="history-heading">History</h2>
  <% unless entries.any? { |entry| entry.kind == :reveal } %>
    <p>No phase has been revealed yet.</p>
  <% end %>
  <% if entries.any? %>
    <ul class="list">
      <% entries.each do |entry| %>
        <% case entry.kind %>
        <% when :reveal %>
          <li><%= link_to game_host_results_path(game.public_id, entry.phase.number), class: "list__row" do %><span class="mono"><%= entry.phase.title %></span> <span>revealed</span> <span class="text-muted"><%= table_time(entry.created_at) %></span><% end %></li>
        <% when :position_edit %>
          <li><div class="list__row"><span class="mono"><%= entry.phase.title %></span> <span>board changed: <%= position_edit_text(entry.detail) %></span> <span class="text-muted"><%= table_time(entry.created_at) %></span></div></li>
        <% else %>
          <li><div class="list__row"><span class="mono"><%= entry.phase.title %></span> <%= power_badge(entry.seat.power) %> <span><%= entry.kind == :reissue ? "seat reissued" : "stepped in" %></span> <span class="text-muted"><%= table_time(entry.created_at) %></span></div></li>
        <% end %>
      <% end %>
    </ul>
  <% end %>
</section>
