<%# The game's seat history: each step-in, reissue and board edit, oldest first (spec 026 D6, D10, spec 027 D4). Phases, powers and times only. locals: game %>
<% entries = game.seat_history %>
<section class="stack" aria-labelledby="seat-history-heading" data-seat-history>
  <h2 id="seat-history-heading">Seat history</h2>
  <% if entries.empty? %>
    <p>Nothing has happened to a seat yet.</p>
  <% else %>
    <ul class="list">
      <% entries.each do |entry| %>
        <% if entry.kind == :position_edit %>
          <li><div class="list__row"><span class="mono"><%= entry.phase.title %></span> <span>board changed: <%= position_edit_text(entry.detail) %></span> <span class="text-muted"><%= table_time(entry.created_at) %></span></div></li>
        <% else %>
          <li><div class="list__row"><span class="mono"><%= entry.phase.title %></span> <%= power_badge(entry.seat.power) %> <span><%= entry.kind == :reissue ? "seat reissued" : "stepped in" %></span> <span class="text-muted"><%= table_time(entry.created_at) %></span></div></li>
        <% end %>
      <% end %>
    </ul>
  <% end %>
</section>
