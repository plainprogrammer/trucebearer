<% content_for :title, "Style guide" %>

<% content_for :actions do %>
  <button type="button" class="button button--secondary">Back</button>
  <button type="button" class="button">Send</button>
<% end %>

<div class="stack">
  <h1>Style guide</h1>
  <p>The tokens and parts of the base stylesheet. Only available while developing. Change the stylesheet, then check this page at 360 and 768 pixels wide.</p>

  <section data-component="heading-text" class="stack" aria-labelledby="sg-text">
    <h2 id="sg-text">Headings and text</h2>
    <h1 role="none">Heading one</h1>
    <h2 role="none">Heading two</h2>
    <h3 role="none">Heading three</h3>
    <p>Body text is one rem. <span class="text-muted">Muted text is for hints.</span> <small>Small text is the smallest step.</small></p>
    <ul class="sg-type">
      <% StyleguideHelper::TYPE_STEPS.each do |step| %>
        <li class="sg-type-step sg-type-step--<%= step %>">--text-<%= step %></li>
      <% end %>
    </ul>
    <ul class="sg-space">
      <% StyleguideHelper::SPACE_STEPS.each do |step| %>
        <li class="sg-space-step"><span class="sg-space-bar sg-space-bar--<%= step %>"></span> --space-<%= step %></li>
      <% end %>
    </ul>
  </section>

  <section data-component="link" class="stack" aria-labelledby="sg-link">
    <h2 id="sg-link">Links</h2>
    <p>A link in running text is <a href="#sg-link">underlined and colored</a>, and a visited one is <a href="/">colored differently</a>.</p>
  </section>

  <section data-component="button" class="stack" aria-labelledby="sg-button">
    <h2 id="sg-button">Buttons</h2>
    <div class="sg-row">
      <button type="button" class="button">Primary</button>
      <button type="button" class="button button--secondary">Secondary</button>
      <button type="button" class="button button--danger">Danger</button>
    </div>
    <div class="sg-row">
      <button type="button" class="button" disabled>Primary</button>
      <button type="button" class="button button--secondary" disabled>Secondary</button>
      <button type="button" class="button button--danger" disabled>Danger</button>
    </div>
    <div class="sg-row">
      <a href="#sg-button" class="button">Link as button</a>
      <a class="button button--secondary" role="link" aria-disabled="true">Disabled link</a>
      <input type="submit" class="button" value="Submit input">
    </div>
  </section>

  <section data-component="list" class="stack" aria-labelledby="sg-list">
    <h2 id="sg-list">Lists</h2>
    <ul class="list">
      <li><a href="#sg-list" class="list__row">A row you can tap</a></li>
      <li><a href="#sg-list" class="list__row">Another row you can tap</a></li>
      <li><div class="list__row">A row with text only</div></li>
    </ul>
  </section>

  <section data-component="field" class="stack" aria-labelledby="sg-field">
    <h2 id="sg-field">Form fields</h2>
    <div class="field">
      <label class="field__label" for="sg-name">Name</label>
      <input class="control" id="sg-name" type="text" autocomplete="off" aria-describedby="sg-name-hint">
      <span class="field__hint" id="sg-name-hint">What the others at the table call you.</span>
    </div>
    <div class="field">
      <label class="field__label" for="sg-email">Email</label>
      <input class="control" id="sg-email" type="email" autocomplete="off">
    </div>
    <div class="field">
      <label class="field__label" for="sg-number">Number</label>
      <input class="control" id="sg-number" type="number" inputmode="numeric">
    </div>
    <div class="field">
      <label class="field__label" for="sg-search">Search</label>
      <input class="control" id="sg-search" type="search">
    </div>
    <div class="field">
      <label class="field__label" for="sg-power">Choose one</label>
      <select class="control" id="sg-power">
        <option>First</option>
        <option>Second</option>
      </select>
    </div>
    <div class="field">
      <label class="field__label" for="sg-note">Note</label>
      <textarea class="control" id="sg-note"></textarea>
    </div>
    <div class="field">
      <label class="field__label" for="sg-code">Code (required)</label>
      <input class="control" id="sg-code" type="text" aria-invalid="true" aria-describedby="sg-code-error" required>
      <p class="field__error" id="sg-code-error">Error: enter the code you were given.</p>
    </div>
    <div class="field">
      <label class="field__label" for="sg-off">Not available</label>
      <input class="control" id="sg-off" type="text" disabled value="Disabled">
    </div>
  </section>

  <section data-component="choice" class="stack" aria-labelledby="sg-choice">
    <h2 id="sg-choice">Choices</h2>
    <fieldset class="choices">
      <legend>Pick any</legend>
      <label class="choice"><input type="checkbox"> First option</label>
      <label class="choice"><input type="checkbox" checked> Second option</label>
      <label class="choice choice--disabled"><input type="checkbox" disabled> Not available</label>
    </fieldset>
    <fieldset class="choices">
      <legend>Pick one</legend>
      <label class="choice"><input type="radio" name="sg-radio"> Left</label>
      <label class="choice"><input type="radio" name="sg-radio" checked> Right</label>
    </fieldset>
  </section>

  <section data-component="power-badge" class="stack" aria-labelledby="sg-power-badge">
    <h2 id="sg-power-badge">Power badges</h2>
    <p>A power's color always comes with its name.</p>
    <ul class="sg-powers">
      <% StyleguideHelper::POWER_IDS.each do |id| %>
        <li class="sg-power"><%= power_badge(id) %> <code class="sg-power__token">--color-power-<%= id %></code></li>
      <% end %>
    </ul>
  </section>

  <section data-component="unit-icon" class="stack" aria-labelledby="sg-unit-icon">
    <h2 id="sg-unit-icon">Unit icons</h2>
    <p>An army and a fleet for each power, at 20, 32 and 48 pixels. The tag in the corner holds the power's initial. The first row sits on <code>ice-pale</code>.</p>
    <ul class="sg-units">
      <% StyleguideHelper::POWER_IDS.each_with_index do |id, index| %>
        <li class="sg-unit<%= " sg-bg-ice-pale" if index.zero? %>">
          <span class="sg-unit__name"><%= PowerBadgeHelper::POWER_NAMES.fetch(id) %></span>
          <span class="sg-unit__icons">
            <% StyleguideHelper::UNIT_TYPES.each do |type| %>
              <% StyleguideHelper::UNIT_SIZES.each do |size| %>
                <%= unit_icon(id, type, size: size, decorative: true) %>
              <% end %>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
    <p>With no name beside it, an icon carries its own label, which a screen reader reads out:</p>
    <p><%= unit_icon(:austria, :army) %> <%= unit_icon(:england, :fleet) %></p>
  </section>

  <section data-component="supply-center-icon" class="stack" aria-labelledby="sg-supply-icon">
    <h2 id="sg-supply-icon">Supply-center icons</h2>
    <p>A center owned by each power, and an unowned one.</p>
    <ul class="sg-supply">
      <% StyleguideHelper::POWER_IDS.each do |id| %>
        <li class="sg-supply__item"><%= supply_center_icon(id, decorative: true) %> <span class="sg-supply__name"><%= PowerBadgeHelper::POWER_NAMES.fetch(id) %></span></li>
      <% end %>
      <li class="sg-supply__item"><%= supply_center_icon(nil, decorative: true) %> <span class="sg-supply__name">Unowned</span></li>
    </ul>
  </section>

  <section data-component="mono-text" class="stack" aria-labelledby="sg-mono">
    <h2 id="sg-mono">Mono text</h2>
    <p>The <code>mono</code> class sets text in the one self-hosted monospace. It is for codes and tags, not for sentences.</p>
    <p class="mono">JOIN 4F7-K2Q &middot; PAR &middot; SPRING 1901</p>
  </section>

  <section data-component="join-code" class="stack" aria-labelledby="sg-join-code">
    <h2 id="sg-join-code">Join code</h2>
    <p>Six characters in two groups of three, in mono type.</p>
    <%= join_code_text("ACDEFG") %>
  </section>

  <section data-component="qr-card" class="stack" aria-labelledby="sg-qr-card">
    <h2 id="sg-qr-card">QR card</h2>
    <p>The code on white, with a caption under it. For a game the caption is its join code; for a seat it is the power's badge.</p>
    <%= qr_card("https://example.org/join/ACDEFG", label: "Example QR code", caption: join_code_text("ACDEFG")) %>
    <%= qr_card("https://example.org/games/abc/seat-link?token=example", label: "Example seat QR code", caption: power_badge(:italy)) %>
  </section>

  <section data-component="power-tile" class="stack" aria-labelledby="sg-power-tile">
    <h2 id="sg-power-tile">Power tiles</h2>
    <p>An open tile is a button. A taken tile says "Taken" and is not a control.</p>
    <%= power_tiles(taken: %w[austria italy]) %>
  </section>

  <section data-component="host-section" class="stack" aria-labelledby="sg-host-section">
    <h2 id="sg-host-section">Host section</h2>
    <div class="host-section stack">
      <h3>Host</h3>
      <p>The host's controls sit on a pale ground, apart from a player's own screen.</p>
      <a class="button" href="#sg-host-section">A host action</a>
      <a class="button button--secondary" href="#sg-host-section">Another action</a>
      <a class="button button--danger" href="#sg-host-section">A destructive action</a>
      <p><a href="#sg-host-section">A link on the ground</a></p>
    </div>
  </section>

  <section data-component="phase-header" class="stack" aria-labelledby="sg-phase-header">
    <h2 id="sg-phase-header">Phase header</h2>
    <p>Season, year and phase type in mono capitals. A player's page shows their power's badge at the end.</p>
    <% sample_phase = Phase.new(position: RulesEngine.starting_position) %>
    <%= render "phases/header", phase: sample_phase, power: "england" %>
    <%= render "phases/header", phase: sample_phase %>
  </section>

  <section data-component="banner" class="stack" aria-labelledby="sg-banner">
    <h2 id="sg-banner">Banner</h2>
    <p>One sentence. Warnings and errors start with a word, so the kind never rests on colour.</p>
    <%= render "shared/banner", kind: "info", text: "Submitted." %>
    <%= render "shared/banner", kind: "warning", text: "Austria's army in SER was dislodged. Settle it by hand." %>
    <%= render "shared/banner", kind: "danger", text: "The host has already revealed this phase. Your orders were not saved." %>
  </section>

  <section data-component="confirm" class="stack" aria-labelledby="sg-confirm">
    <h2 id="sg-confirm">Confirmation page</h2>
    <p>A full page, never a modal: a heading, what will happen in plain words, a confirm button and a way back.</p>
    <%= render layout: "shared/confirm", locals: { title: "Reveal the orders?", heading: "h2", confirm_label: "Reveal orders",
          confirm_path: nil, cancel_path: "#sg-confirm" } do %>
      <p>Orders are locked and adjudicated. This cannot be undone.</p>
    <% end %>
    <%= render layout: "shared/confirm", locals: { title: "Close joining", heading: "h2", confirm_label: "Close joining", danger: true,
          confirm_path: nil, cancel_path: "#sg-confirm" } do %>
      <p>Closing cannot be undone.</p>
    <% end %>
  </section>

  <% sample_game = StyleguideHelper::SAMPLE_GAME %>
  <% sample_position = RulesEngine.starting_position %>
  <% sample_unit = sample_position.units.find { |u| u.location.province == :kie } %>
  <% sample_order = RulesEngine.load_order("format" => 1, "type" => "move", "power" => "germany", "at" => "kie",
                                           "destination" => { "province" => "den", "coast" => nil }) %>
  <% sample_phase = StyleguideHelper::SAMPLE_PHASE %>
  <% sample_step = OrderChoices.new(sample_position, sample_unit, ordered: true).step("kind" => "move") %>

  <section data-component="unit-row" class="stack" aria-labelledby="sg-unit-row">
    <h2 id="sg-unit-row">Unit row</h2>
    <p>One of a player's units: the icon, its place in full with the abbreviation, and its order. A unit with no order says "holds".</p>
    <ul class="list">
      <%= render "seat_orders/unit_row", unit: sample_unit, order: sample_order, game: sample_game, phase: sample_phase %>
      <%= render "seat_orders/unit_row", unit: sample_position.units.find { |u| u.location.province == :ber }, order: nil, game: sample_game, phase: sample_phase %>
    </ul>
  </section>

  <section data-component="picker" class="stack picker" aria-labelledby="sg-picker">
    <h2 id="sg-picker">Picker step</h2>
    <p>The order so far, then the choices. Each step is a page; a choice is a link, and the last pick saves.</p>
    <%= render "order_pickers/draft", unit: sample_unit, trail: sample_step.trail %>
    <ul class="list">
      <% sample_step.choices.each do |choice| %>
        <li><%= link_to "#sg-picker", class: "list__row" do %><%= render "order_pickers/choice", choice: choice %><% end %></li>
      <% end %>
      <li><%= link_to "#sg-picker", class: "list__row" do %><%= render "order_pickers/choice", choice: OrderChoices::Choice.new(nil, "nwy", "needs a convoy", nil, nil) %><% end %></li>
    </ul>
  </section>

  <section data-component="submit-bar" class="stack" aria-labelledby="sg-submit-bar">
    <h2 id="sg-submit-bar">Submit bar</h2>
    <p>Sticky at the foot of the order screen. The save status and the submitted state are words, so colour is never the only signal.</p>
    <%= render "seat_orders/submit_bar", game: sample_game, phase: sample_phase, submitted: false, ordered: 3, total: 5, state: :saved %>
    <%= render "seat_orders/submit_bar", game: sample_game, phase: sample_phase, submitted: true, ordered: 5, total: 5, state: :saved %>
    <%= render "shared/save_status", state: :saves_on_pick %>
    <%= render "shared/save_status", state: :not_saved %>
    <%= render "shared/save_status", state: :saved, saving: true %>
  </section>

  <% sample_powers = RulesEngine.powers.map { |power| power.id.to_s } %>
  <section data-component="seat-status" class="stack" aria-labelledby="sg-seat-status">
    <h2 id="sg-seat-status">Seat status</h2>
    <p>Who has submitted: one row for each of the seven powers, the badge and then the state in words. On the seat page and next to the host's reveal button the list is live, and a changed row is the only part announced.</p>
    <%= seat_status(sample_powers.map { |power| Phase::Status.new(power: power, submitted: true) }, id: "sg-seat-status-all") %>
    <%= seat_status(sample_powers.map { |power| Phase::Status.new(power: power, submitted: false) }, id: "sg-seat-status-none") %>
    <%= seat_status(sample_powers.map { |power| Phase::Status.new(power: power, submitted: %w[england france].include?(power)) }, id: "sg-seat-status-mix") %>
  </section>

  <section data-component="segmented" class="stack" aria-labelledby="sg-segmented">
    <h2 id="sg-segmented">Segmented toggle</h2>
    <p>A choice of two or three, drawn as joined buttons. The radios stay real radios, so it works by touch, by keyboard and with no script.</p>
    <%= render "shared/segmented", legend: "Unit, army selected", name: "sg-unit-army", options: [ %w[army Army], %w[fleet Fleet] ], selected: "army" %>
    <%= render "shared/segmented", legend: "Unit, fleet selected", name: "sg-unit-fleet", options: [ %w[army Army], %w[fleet Fleet] ], selected: "fleet" %>
  </section>

  <% player_group, reading_group = sample_result_groups %>
  <section data-component="results" class="stack" aria-labelledby="sg-results">
    <h2 id="sg-results">Results</h2>
    <p>One power's orders and what became of each, after the reveal. Every outcome is words in a tag, and a dislodged unit comes first. The host's reading variant is larger.</p>
    <%= render "results/group", group: player_group, reading: false %>
    <%= render "results/group", group: reading_group, reading: true %>
  </section>

  <section class="stack" aria-labelledby="sg-colors">
    <h2 id="sg-colors">Colors</h2>
    <ul class="sg-swatches">
      <% StyleguideHelper::COLOR_TOKENS.each do |token| %>
        <li class="sg-swatch"><span class="sg-chip sg-bg-<%= token %>"></span> <code class="sg-swatch__name">--color-<%= token %></code></li>
      <% end %>
    </ul>
    <h3>Documented pairs</h3>
    <p class="text-muted">Each sample shows the foreground on its background. The contrast spec measures every pair, power pairs included.</p>
    <ul class="sg-samples">
      <% StyleguideHelper::PAIRS.each do |fg, bg, min| %>
        <% text_pair = min.to_f >= 4.5 %>
        <li class="sg-sample sg-bg-<%= bg %><%= " sg-fg-#{fg}" if text_pair %>">
          <% if text_pair %>
            <span>Sample text</span>
          <% else %>
            <span class="sg-bar sg-bg-<%= fg %>"></span>
          <% end %>
          <span class="sg-sample__meta"><%= fg %> on <%= bg %> (min <%= min %>)</span>
        </li>
      <% end %>
    </ul>
  </section>
</div>
